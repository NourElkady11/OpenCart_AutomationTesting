	    <classes>
		     <class name="testCases.TC001_AccountRegisterTest"/>
		     <class name="testCases.TC002_LoginTest"/> 
		     <class name="testCases.TC003_DDT_LoginTest"/> 
	    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
