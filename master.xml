<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MasterSuite">
	<groups>
			<run>
					<include name="Master"/>  
				<!-- 	<include name="Regression"/>  -->
				 	<!--	<include name="Sanity"/>  -->
				<!-- 	<exclude name=""/> use this when you have 2 groups in 1 test but you want to execlude the one that conntains another GP	-->
			</run>
					
	</groups>
	
	<listeners>
